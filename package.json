{
  "name": "velocity-vehicle-assets",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A reusable collection of licensed vehicle assets with an interactive Three.js showcase.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:cars": "node scripts/build-car-assets.js",
    "build:track": "node scripts/build-coastal-track.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "validate:cars": "node scripts/validate-assets.js",
    "validate:track": "node scripts/validate-track-assets.js",
    "validate:assets": "npm run validate:cars && npm run validate:track"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.9",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "gltf-validator": "^2.0.0-dev.3.10",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.5"
  }
}
